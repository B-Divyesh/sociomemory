# SocioMemory Configuration

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sociomemory
# For Supabase: postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379/0

# OpenAI / Azure OpenAI for embeddings
OPENAI_API_KEY=your-openai-api-key
# Or for Azure:
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_KEY=your-azure-key
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# Embedding configuration
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DIMENSIONS=1536

# FSRS Configuration
FSRS_DESIRED_RETENTION=0.9
FSRS_MAX_INTERVAL=365

# API Configuration
API_HOST=0.0.0.0
API_PORT=8001
API_DEBUG=true

# Security
API_KEY=your-secret-api-key
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
